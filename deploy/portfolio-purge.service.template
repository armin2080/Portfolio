[Unit]
Description=Delete old portfolio page-view statistics
After=portfolio.service

[Service]
Type=oneshot
User=__APP_USER__
Group=__APP_GROUP__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/.env
ExecStart=__PROJECT_DIR__/.venv/bin/python manage.py purge_pageviews
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# __PROJECT_DIR__ is required: this command writes to the SQLite database, which
# lives in the project directory, and SQLite needs write access to the directory
# for its journal even to roll one back when reading.
ReadWritePaths=/var/lib/portfolio __PROJECT_DIR__
