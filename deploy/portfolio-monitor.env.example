# Alerting and host monitoring, read by /usr/local/bin/portfolio-notify and
# /usr/local/bin/portfolio-watchdog. Installed as /etc/portfolio-monitor.env
# with mode 0600; deploy/install-systemd.sh creates it and generates a topic.

# Delivery for alerts. Create a topic on ntfy.sh (or your own ntfy server) and
# subscribe to it in the ntfy app. Use a long random topic name: on the public
# ntfy.sh, anyone who knows the name can read the messages.
#   NTFY_URL=https://ntfy.sh/your-long-random-topic
# Leave empty to write alerts to the journal only (journalctl -u portfolio-alert).
NTFY_URL=

# Loopback health check. HEALTH_HOST must be in ALLOWED_HOSTS.
HEALTH_HOST=localhost
HEALTH_PORT=80

# Warn thresholds.
DISK_MAX_PERCENT=90
MEMORY_MIN_MB=128
DISK_PATHS="/ /var/lib/portfolio"

# Where `manage.py backup_portfolio` writes, and how old a backup may get
# before the watchdog complains. Keep this in sync with BACKUP_DIR in .env.
BACKUP_DIR=/var/backups/portfolio
BACKUP_MAX_AGE_HOURS=36
BACKUP_REQUIRED=1

# If a problem persists, send it again at most this often (seconds).
REPEAT_ALERT_SECONDS=3600
