# Production configuration template (used by deploy/install-systemd.sh).
#
# For local development you generally do NOT need a .env file at all: the
# defaults in Personal_Portfolio/settings.py use DEBUG=True and db.sqlite3.
# If you copy this file locally, set DEBUG=True, SECURE_SSL_REDIRECT=False and
# a local DB_NAME, otherwise runserver will redirect to HTTPS and fail.

# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,armin2080.de,www.armin2080.de
# Canonical origin used for canonical/Open Graph URLs and robots.txt
SITE_URL=https://armin2080.de

# Lightweight local storage
DB_NAME=/var/lib/portfolio/db.sqlite3
STATIC_ROOT=/var/lib/portfolio/staticfiles
MEDIA_ROOT=/var/lib/portfolio/media

# Gunicorn
GUNICORN_BIND=0.0.0.0:80
GUNICORN_WORKERS=1
# Must stay above RESUME_LATEX_TIMEOUT. A CV compile takes ~20s on a Raspberry
# Pi, and with a single synchronous worker a request that outlives this timeout
# gets the worker killed, taking the whole site down rather than one download.
GUNICORN_TIMEOUT=60

# Rate limiting cache, and the generated-CV cache.
# Keep this OUT of /tmp: the service sets PrivateTmp=true, so it gets its own
# /tmp which is wiped on every restart — including the nightly 06:00 start. The
# CV would then be rebuilt at the start of every day, and contact-form rate
# limits would reset on every restart.
CACHE_LOCATION=/var/lib/portfolio/cache

# Trust CF-Connecting-IP / X-Forwarded-For to identify visitors for rate limiting.
# Proxy headers are only read when the direct peer is a Cloudflare edge address
# (or loopback, for a local reverse proxy / Cloudflare Tunnel), so a client that
# reaches the origin directly cannot spoof them. Keep True behind Cloudflare;
# set False only to ignore proxy headers from Cloudflare as well.
TRUST_PROXY_HEADERS=True

# Google reCAPTCHA v3 (get keys at https://www.google.com/recaptcha/admin)
RECAPTCHA_PUBLIC_KEY=your-recaptcha-site-key
RECAPTCHA_PRIVATE_KEY=your-recaptcha-secret-key

# Contact form email
# EMAIL_BACKEND: 'smtp' sends real mail, 'console' prints to the terminal.
# In production it defaults to 'smtp'; in development it defaults to 'console'.
EMAIL_BACKEND=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Redirect plain HTTP to HTTPS (production). Set to False for direct LAN access.
SECURE_SSL_REDIRECT=True

# Local time zone (also used for the daily statistics buckets)
TIME_ZONE=Europe/Berlin

# Anonymous visitor statistics (private dashboard at /dashboard/)
# No cookies, no third-party service, and no IP addresses are stored.
ANALYTICS_ENABLED=True
# Secret used to derive the daily visitor pseudonym. Leave empty to derive one
# from SECRET_KEY; set an explicit random value to rotate pseudonyms.
ANALYTICS_SALT=
# Page views older than this are deleted by the daily systemd timer. Crawler
# rows (recorded but flagged, and excluded from the figures) are kept for the
# shorter window below, because they are cheap to produce and worth little.
ANALYTICS_RETENTION_DAYS=180
ANALYTICS_BOT_RETENTION_DAYS=7

# GitHub project sync
# Public repositories are imported as projects once a day. Forks, archived and
# disabled repositories are skipped. Without a token the GitHub API allows 60
# requests per hour, which is far more than a daily sync needs.
GITHUB_USERNAME=armin2080
GITHUB_TOKEN=

# Media cleanup (monthly systemd timer runs `manage.py prune_media --delete`).
# Unreferenced files modified within this many hours are left alone, so a new
# upload whose database row is still pending cannot be deleted.
MEDIA_PRUNE_MIN_AGE_HOURS=24

# CV generated from the site's content (LaTeX -> PDF)
# The download button renders resume/resume.tex from the database and compiles
# it. Tectonic is used by default; run scripts/install-latex.sh to fetch it into
# .latex/. Leave empty to auto-detect, or set a binary name or full path.
RESUME_LATEX_ENGINE=
# Compile limit. MUST stay below GUNICORN_TIMEOUT: the site runs one synchronous
# worker, so a compile that outlives the worker timeout kills the worker and
# takes the whole site down with it. Measured on a Raspberry Pi Zero 2 W: a warm
# compile is ~19-24s, so 45 leaves headroom. On a laptop 1s is plenty.
RESUME_LATEX_TIMEOUT=45
# How long a request waits for a compile another request already started. Above
# a full compile so the waiting request gets the result rather than an error.
RESUME_LATEX_WAIT_SECONDS=40
# How long a generated PDF stays cached. The cache key is a hash of the content,
# so it can never serve a stale CV; this only bounds recompiling. 0 disables.
RESUME_LATEX_CACHE_SECONDS=604800
# A global ceiling on compiles per hour, across all visitors. Cache hits do not
# count, and `build_resume` bypasses it so a restart can always warm the cache.
# 0 disables the ceiling.
RESUME_LATEX_MAX_COMPILES_PER_HOUR=12
# Where Tectonic keeps its downloaded support files. The systemd sandbox makes
# everything under /home read-only except the project dir, so point this at a
# writable path (the service already has /var/lib/portfolio in ReadWritePaths).
RESUME_LATEX_CACHE_DIR=/var/lib/portfolio/tectonic

# The one-page content budget. The CV is meant to be a single A4 page, and there
# is more on the site than fits on one, so these caps decide what goes in. They
# apply to the generator's selections too: choosing more than a cap lists the
# most relevant ones. Tune with `scripts/measure-resume.py`, which reports the
# page count for whatever database it is pointed at.
RESUME_MAX_EXPERIENCE=4
RESUME_MAX_EDUCATION=2
RESUME_MAX_PROJECTS=3
RESUME_MAX_SKILLS=10
RESUME_MAX_CERTIFICATES=5

# Bullets per entry, characters per bullet (measured on the visible text, and
# shortened at a sentence boundary where possible), and technologies per project
# heading. These are what actually hold the document to one page.
RESUME_MAX_EXPERIENCE_BULLETS=2
RESUME_MAX_EDUCATION_BULLETS=1
RESUME_MAX_PROJECT_BULLETS=1
RESUME_MAX_BULLET_CHARS=170
RESUME_MAX_PROJECT_TECHNOLOGIES=4
