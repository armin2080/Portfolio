# Production configuration template (used by deploy/install-systemd.sh).
#
# For local development you generally do NOT need a .env file at all: the
# defaults in Personal_Portfolio/settings.py use DEBUG=True and db.sqlite3.
# If you copy this file locally, set DEBUG=True, SECURE_SSL_REDIRECT=False and
# a local DB_NAME, otherwise runserver will redirect to HTTPS and fail.

# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,armin2080.de,www.armin2080.de
# Canonical origin used for canonical/Open Graph URLs and robots.txt
SITE_URL=https://armin2080.de

# Lightweight local storage
DB_NAME=/var/lib/portfolio/db.sqlite3
STATIC_ROOT=/var/lib/portfolio/staticfiles
MEDIA_ROOT=/var/lib/portfolio/media

# Gunicorn
GUNICORN_BIND=0.0.0.0:80
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=30

# Rate limiting cache
CACHE_LOCATION=/tmp/django_cache

# Trust CF-Connecting-IP / X-Forwarded-For to identify visitors for rate limiting.
# Keep True while the site is reachable only through Cloudflare. Set False if the
# app can also be reached directly, otherwise clients could spoof the header and
# bypass the contact form limit.
TRUST_PROXY_HEADERS=True

# Google reCAPTCHA v3 (get keys at https://www.google.com/recaptcha/admin)
RECAPTCHA_PUBLIC_KEY=your-recaptcha-site-key
RECAPTCHA_PRIVATE_KEY=your-recaptcha-secret-key

# Contact form email
# EMAIL_BACKEND: 'smtp' sends real mail, 'console' prints to the terminal.
# In production it defaults to 'smtp'; in development it defaults to 'console'.
EMAIL_BACKEND=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Redirect plain HTTP to HTTPS (production). Set to False for direct LAN access.
SECURE_SSL_REDIRECT=True

# Local time zone (also used for the daily statistics buckets)
TIME_ZONE=Europe/Berlin

# Anonymous visitor statistics (private dashboard at /dashboard/)
# No cookies, no third-party service, and no IP addresses are stored.
ANALYTICS_ENABLED=True
# Secret used to derive the daily visitor pseudonym. Leave empty to derive one
# from SECRET_KEY; set an explicit random value to rotate pseudonyms.
ANALYTICS_SALT=
# Page views older than this are deleted by the daily systemd timer.
ANALYTICS_RETENTION_DAYS=180

# GitHub project sync
# Public repositories are imported as projects once a day. Forks, archived and
# disabled repositories are skipped. Without a token the GitHub API allows 60
# requests per hour, which is far more than a daily sync needs.
GITHUB_USERNAME=armin2080
GITHUB_TOKEN=

# Media cleanup (monthly systemd timer runs `manage.py prune_media --delete`).
# Unreferenced files modified within this many hours are left alone, so a new
# upload whose database row is still pending cannot be deleted.
MEDIA_PRUNE_MIN_AGE_HOURS=24
